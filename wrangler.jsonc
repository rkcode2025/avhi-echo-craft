{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avhi-echo-craft",
  "compatibility_date": "2026-06-10",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  }
}
